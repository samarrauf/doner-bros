# Copy to .env and fill in real values. Never commit .env.
# Claude powers the AI Order Taker chat. CHAT_MODEL is optional (defaults to claude-haiku-5-5).
ANTHROPIC_API_KEY=
CHAT_MODEL=
PORT=3000
# No longer used by the chat; kept until Stage 13.
GEMINI_API_KEY=
# Supabase orders database. The service role key is secret: backend only, never the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Kitchen login at /kitchen/login (kitchen board only). Use a long, unique one.
STAFF_PASSWORD=
# Owner login at /owner/login (dashboard, photos, analytics and the kitchen). Must differ from
# STAFF_PASSWORD. Owner login stays off while this is empty.
OWNER_PASSWORD=
